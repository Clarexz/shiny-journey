# Evolution API. Copiar a infra/env/evolution.env (chmod 600).
# Persistencia mínima (plan, 5.3): no se guardan mensajes, chats ni contactos.
# La imagen copia su .env.example como /evolution/.env con casi todo en true (guardar mensajes,
# chats, contactos, IsOnWhatsapp, telemetría...). dotenv solo respeta las variables definidas
# aquí: todo lo que afecte la privacidad debe quedar explícito en este archivo (T1.6).
AUTHENTICATION_API_KEY=
SERVER_URL=https://evo.ravyn-crm.cloud
CONFIG_SESSION_PHONE_CLIENT=Chrome

DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
# Misma contraseña que POSTGRES_PASSWORD en evolution-db.env.
DATABASE_CONNECTION_URI=postgresql://evolution:CAMBIAR@evolution-db:5432/evolution
DATABASE_CONNECTION_CLIENT_NAME=ravyn_agents
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=false
DATABASE_SAVE_MESSAGE_UPDATE=false
DATABASE_SAVE_DATA_CONTACTS=false
DATABASE_SAVE_DATA_CHATS=false
DATABASE_SAVE_DATA_LABELS=false
# Caché de números consultados/vistos (IsOnWhatsapp): con true guarda los JIDs de todos los
# contactos del teléfono al conectar. Default de la imagen: true.
DATABASE_SAVE_IS_ON_WHATSAPP=false
DATABASE_SAVE_DATA_HISTORIC=false

CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://redis:6379/2
CACHE_REDIS_PREFIX_KEY=evolution
CACHE_LOCAL_ENABLED=false

# Los webhooks se configuran por instancia (apuntan a http://worker:3001/webhooks/...).
WEBHOOK_GLOBAL_ENABLED=false
LOG_LEVEL=ERROR,WARN
LOG_BAILEYS=error

# Sin telemetría hacia Evolution ni tokens de instancia en /instance/fetchInstances.
TELEMETRY_ENABLED=false
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=false

# Integraciones apagadas de forma explícita (hoy ya vienen en false en la imagen).
WEBSOCKET_ENABLED=false
RABBITMQ_ENABLED=false
SQS_ENABLED=false
PUSHER_ENABLED=false
KAFKA_ENABLED=false
NATS_ENABLED=false
S3_ENABLED=false
CHATWOOT_ENABLED=false
TYPEBOT_ENABLED=false
OPENAI_ENABLED=false
DIFY_ENABLED=false
N8N_ENABLED=false
EVOAI_ENABLED=false
