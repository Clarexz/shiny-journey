# Evolution API. Copiar a infra/env/evolution.env (chmod 600).
# Persistencia mínima (plan, 5.3): no se guardan mensajes, chats ni contactos.
AUTHENTICATION_API_KEY=
SERVER_URL=https://evo.ravyn-crm.cloud
CONFIG_SESSION_PHONE_CLIENT=Chrome

DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
# Misma contraseña que POSTGRES_PASSWORD en evolution-db.env.
DATABASE_CONNECTION_URI=postgresql://evolution:CAMBIAR@evolution-db:5432/evolution
DATABASE_CONNECTION_CLIENT_NAME=ravyn_agents
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=false
DATABASE_SAVE_MESSAGE_UPDATE=false
DATABASE_SAVE_DATA_CONTACTS=false
DATABASE_SAVE_DATA_CHATS=false
DATABASE_SAVE_DATA_LABELS=false
DATABASE_SAVE_DATA_HISTORIC=false

CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://redis:6379/2
CACHE_REDIS_PREFIX_KEY=evolution
CACHE_LOCAL_ENABLED=false

# Los webhooks se configuran por instancia (apuntan a http://worker:3001/webhooks/...).
WEBHOOK_GLOBAL_ENABLED=false
LOG_LEVEL=ERROR,WARN
LOG_BAILEYS=error
