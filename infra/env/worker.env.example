# Worker. Copiar a infra/env/worker.env (chmod 600).
NODE_ENV=production
PORT=3001
SUPABASE_INTERNAL_URL=http://supabase-kong:8000
SUPABASE_SERVICE_ROLE_KEY=
REDIS_URL=redis://redis:6379/0
EVOLUTION_BASE_URL=http://evolution:8080
EVOLUTION_API_KEY=
WEBHOOK_BASE_URL=http://worker:3001
WORKER_INTERNAL_TOKEN=
LLM_PROVIDER=openai
OPENAI_API_KEY=
LLM_MODEL=gpt-6-luna
# gpt-6-luna razona en "medium" por defecto: "none" mantiene la latencia baja.
LLM_REASONING_EFFORT=none
LLM_TIMEOUT_MS=2000
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@ravyn-crm.cloud
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Ravyn <avisos@ravyn-crm.cloud>"
TELEGRAM_BOT_TOKEN=
TELEGRAM_OPS_CHAT_ID=
ACTION_TOKEN_PEPPER=
CHANNEL_DRY_RUN=false
LOG_LEVEL=info
