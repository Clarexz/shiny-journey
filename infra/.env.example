# Variables de interpolación de infra/docker-compose.yml. Copiar a infra/.env (chmod 600).
# deploy.sh actualiza APP_VERSION en cada despliegue.

# SHA del commit publicado en GHCR (ghcr.io/clarexz/shiny-journey-{web,worker}:<sha>).
APP_VERSION=

# Etiqueta exacta de Evolution (nunca latest). Se cambia solo siguiendo el runbook de
# actualización de Evolution (plan, 10.6).
EVOLUTION_VERSION=

APP_HOST=app.ravyn-crm.cloud
EVO_HOST=evo.ravyn-crm.cloud

# Manager de Evolution: basic auth en formato htpasswd (htpasswd -nbB usuario clave; en este
# archivo cada signo de dólar se escribe doble) y lista de IPs de Ravyn separadas por comas.
EVO_BASIC_AUTH=
EVO_IP_ALLOWLIST=
