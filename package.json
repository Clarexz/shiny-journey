{
  "name": "ravyn-agentes",
  "private": true,
  "description": "Plataforma multi-tenant de agentes de WhatsApp (Ravyn Studio)",
  "engines": {
    "node": ">=22.11"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "modules/*"
  ],
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --schema public > packages/db/src/types.gen.ts && prettier --write packages/db/src/types.gen.ts",
    "check-rls": "npm run check-rls -w @ravyn/db",
    "eval:extractor": "npm run eval:extractor -w @ravyn/module-apartador-turnos --"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "supabase": "^3.2.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  }
}
